# ---------------------------------------------------------------------------
# Copie este archivo a .env y complete los valores. .env esta en .gitignore
# y NUNCA debe versionarse.
# ---------------------------------------------------------------------------

# --- Proveedor de IA -------------------------------------------------------
# Se usa el SDK de OpenAI apuntando a un endpoint OpenAI-compatible.
# Para OpenRouter (modelos gratuitos disponibles para pruebas):
IA_BASE_URL=https://openrouter.ai/api/v1
IA_API_KEY=sk-or-v1-reemplace-esta-llave
IA_MODELO=meta-llama/llama-3.3-70b-instruct:free

# Para usar OpenAI directamente, cambie a:
#   IA_BASE_URL=https://api.openai.com/v1
#   IA_API_KEY=sk-...
#   IA_MODELO=gpt-4o-mini

# Cabeceras que OpenRouter recomienda para identificar la aplicacion
IA_APP_URL=https://github.com/AndresQuintero1999/motos-leads
IA_APP_NOMBRE=Organizador de Leads - Motos y Servicios

# --- Control de costo y robustez del extractor -----------------------------
IA_MAX_CONVERSACIONES=0     # 0 = sin limite. >0 para pruebas rapidas.
IA_CONCURRENCIA=4           # llamadas en paralelo
IA_TIMEOUT_S=60
IA_MAX_REINTENTOS=3
IA_HABILITADA=true          # false = pipeline corre solo con el extractor de reglas

# --- Base de datos ---------------------------------------------------------
DB_PATH=data/warehouse/leads.db

# --- Rutas de insumos ------------------------------------------------------
DIR_DATASETS=datasets-assessment-analista-ia

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# URL donde el tablero encuentra la API. Vacio = misma maquina (localhost),
# como en el despliegue de un solo servicio en Render (ver run_server.py).
API_INTERNAL_URL=http://127.0.0.1:8000

# Tokens de acceso por empresa: cada uno solo ve los leads de su propia
# comercializadora (aislamiento exigido por el enunciado). Son valores de
# DEMOSTRACION, no credenciales reales; en produccion se generarian por
# empresa y se rotarian.
API_TOKEN_EMP_01=demo-token-emp-01
API_TOKEN_EMP_02=demo-token-emp-02
API_TOKEN_EMP_03=demo-token-emp-03

# Token para disparar manualmente una corrida del pipeline via POST
# /admin/pipeline/run (el "webhook" de la condicion de automatizacion).
ADMIN_TOKEN=demo-admin-token
